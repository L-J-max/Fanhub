# ---- Database (Turso / libSQL) ----
# Create a database at https://turso.tech then run:
#   turso db create fanhub
#   turso db tokens create fanhub
TURSO_DATABASE_URL=libsql://<your-db>.turso.io
TURSO_AUTH_TOKEN=<token-from-turso-db-tokens-create>

# ---- File storage (Vercel Blob) ----
# Create a Blob store in the Vercel dashboard, or run `vercel blob token`.
BLOB_READ_WRITE_TOKEN=<vercel-blob-token>

# ---- Session secret (optional but recommended) ----
# Stable HMAC key for signed session cookies. If omitted, a per-deployment
# in-memory secret is used (sessions invalidate on each redeploy).
SESSION_SECRET=<any-long-random-string>

# ---- Local dev only (optional) ----
# Point libSQL at a local file for offline development:
# TURSO_DATABASE_URL=file:./data/local.db
